{
    "version": 4,
    "configurePresets": [
        {
            "name": "vscode-debug",
            "displayName": "KNHV Debug (unsigned)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/vscode/Debug",
            "environment": {
                "VSLANG": "1033"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "KNHV_SIGN": "OFF",
                "KNHV_BUILD_TESTS": "ON",
                "KNHV_BUILD_NESTED_DRIVERS": "ON",
                "KNHV_BUILD_BENCHMARKS": "ON",
                "KNHV_BUILD_PREFLIGHT": "ON",
                "KNHV_BUILD_WHP_BROKER": "ON",
                "KNHV_ARTIFACT_ROOT": "${sourceDir}/build/vscode/Debug",
                "WDK_WINVER": "0x0A00"
            }
        },
        {
            "name": "vscode-release",
            "displayName": "KNHV Release (unsigned)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/vscode/Release",
            "environment": {
                "VSLANG": "1033"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "KNHV_SIGN": "OFF",
                "KNHV_BUILD_TESTS": "ON",
                "KNHV_BUILD_NESTED_DRIVERS": "ON",
                "KNHV_BUILD_BENCHMARKS": "ON",
                "KNHV_BUILD_PREFLIGHT": "ON",
                "KNHV_BUILD_WHP_BROKER": "ON",
                "KNHV_ARTIFACT_ROOT": "${sourceDir}/build/vscode/Release",
                "WDK_WINVER": "0x0A00"
            }
        },
        {
            "name": "sys-debug",
            "displayName": "KNHV SYS Debug",
            "inherits": "vscode-debug",
            "description": "Configure the x64 WDK driver target and emit KNHV.sys",
            "binaryDir": "${sourceDir}/build/vscode/Debug"
        },
        {
            "name": "sys-release",
            "displayName": "KNHV SYS Release",
            "inherits": "vscode-release",
            "description": "Configure the x64 WDK driver target and emit KNHV.sys",
            "binaryDir": "${sourceDir}/build/vscode/Release"
        }
    ],
    "buildPresets": [
        {
            "name": "vscode-debug",
            "configurePreset": "vscode-debug",
            "configuration": "Debug",
            "targets": [
                "KNHV",
                "KNHV_Control",
                "KNHV_NestedTest",
                "KNHV_ContractTests",
                "KNHV_NestedProbe",
                "KNHV_NativeVmxProbe",
                "KNHV_NativeLikeBench",
                "KNHV_VmxExitBench",
                "KNHV_TscQpcBench",
                "KNHV_EptHookBench",
                "KNHV_DeviceIoBench",
                "KNHV_Preflight",
                "KNHV_WHPBroker"
            ]
        },
        {
            "name": "vscode-release",
            "configurePreset": "vscode-release",
            "configuration": "Release",
            "targets": [
                "KNHV",
                "KNHV_Control",
                "KNHV_NestedTest",
                "KNHV_ContractTests",
                "KNHV_NestedProbe",
                "KNHV_NativeVmxProbe",
                "KNHV_NativeLikeBench",
                "KNHV_VmxExitBench",
                "KNHV_TscQpcBench",
                "KNHV_EptHookBench",
                "KNHV_DeviceIoBench",
                "KNHV_Preflight",
                "KNHV_WHPBroker"
            ]
        },
        {
            "name": "sys-debug",
            "displayName": "Build KNHV.sys (Debug)",
            "configurePreset": "sys-debug",
            "configuration": "Debug",
            "targets": [
                "KNHV",
                "KNHV_Control",
                "KNHV_NestedTest",
                "KNHV_ContractTests",
                "KNHV_NestedProbe",
                "KNHV_NativeVmxProbe",
                "KNHV_NativeLikeBench",
                "KNHV_VmxExitBench",
                "KNHV_TscQpcBench",
                "KNHV_EptHookBench",
                "KNHV_DeviceIoBench",
                "KNHV_Preflight",
                "KNHV_WHPBroker"
            ]
        },
        {
            "name": "sys-release",
            "displayName": "Build KNHV.sys (Release)",
            "configurePreset": "sys-release",
            "configuration": "Release",
            "targets": [
                "KNHV",
                "KNHV_Control",
                "KNHV_NestedTest",
                "KNHV_ContractTests",
                "KNHV_NestedProbe",
                "KNHV_NativeVmxProbe",
                "KNHV_NativeLikeBench",
                "KNHV_VmxExitBench",
                "KNHV_TscQpcBench",
                "KNHV_EptHookBench",
                "KNHV_DeviceIoBench",
                "KNHV_Preflight",
                "KNHV_WHPBroker"
            ]
        }
    ]
}
