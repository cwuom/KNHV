{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "configuration",
            "type": "pickString",
            "description": "Driver build configuration",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        },
        {
            "id": "certificate",
            "type": "promptString",
            "description": "Path to a signing PFX containing the private key",
            "default": "${workspaceFolder}\\certs\\Nested_HV_test.pfx"
        },
        {
            "id": "certificatePassword",
            "type": "promptString",
            "description": "PFX password (leave empty for a passwordless certificate)",
            "password": true,
            "default": ""
        },
        {
            "id": "timestampUrl",
            "type": "promptString",
            "description": "RFC3161 timestamp URL (optional)",
            "default": ""
        }
    ],
    "tasks": [
        {
            "label": "Configure Driver (unsigned)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-Driver.ps1",
                "-Configuration",
                "${input:configuration}",
                "-ConfigureOnly"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build Driver (unsigned)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-Driver.ps1",
                "-Configuration",
                "${input:configuration}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure Driver (unsigned)",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build SYS + PDB (Debug)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-Driver.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build SYS + PDB (Release)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-Driver.ps1",
                "-Configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build and Sign SYS (Debug, auto test certificate)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-And-Sign-Driver.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build and Sign SYS (Release, auto test certificate)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Build-And-Sign-Driver.ps1",
                "-Configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Sign Built Driver",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Sign-Driver.ps1",
                "-DriverPath",
                "${workspaceFolder}\\build\\vscode\\${input:configuration}\\Nested_HV.sys",
                "-Certificate",
                "${input:certificate}",
                "-Password",
                "${input:certificatePassword}",
                "-TimestampUrl",
                "${input:timestampUrl}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Driver (unsigned)",
            "problemMatcher": []
        },
        {
            "label": "Build and Sign SYS (manual certificate)",
            "dependsOn": "Sign Built Driver",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Windows TESTSIGNING status",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Set-TestSigning.ps1",
                "-Status"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Enable Windows TESTSIGNING (reboot required)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Set-TestSigning.ps1",
                "-Enable"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Disable Windows TESTSIGNING (reboot required)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\Set-TestSigning.ps1",
                "-Disable"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
