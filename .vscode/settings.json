{
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "vscode-debug",
    "cmake.buildPreset": "vscode-debug",
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.generator": "Ninja",
    "cmake.useVsDeveloperEnvironment": "always",
    "cmake.buildDirectory": "${workspaceFolder}/build/vscode/${buildType}",
    "cmake.configureSettings": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NESTED_HV_SIGN": "OFF",
        "NESTED_HV_BUILD_TESTS": "ON",
        "WDK_WINVER": "0x0A00"
    },
    "cmake.exportCompileCommandsFile": true,
    "cmake.buildBeforeRun": true,
    "cmake.configureOnOpen": true,
    "cmake.preferredGenerators": [
        "Ninja",
        "Visual Studio 18 2026",
        "Visual Studio 17 2022"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${env:WDKContentRoot}/Include/**/km",
        "${env:WDKContentRoot}/Include/**/shared",
        "C:/Program Files (x86)/Windows Kits/10/Include/**/km",
        "C:/Program Files (x86)/Windows Kits/10/Include/**/shared"
    ],
    "files.associations": {
        "*.asm": "asm-intel-x86-generic"
    }
}
